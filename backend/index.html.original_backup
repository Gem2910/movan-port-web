        function openAddApiModal() {
            document.getElementById('form-api-id').value = '';
            document.getElementById('form-api-provider').value = '';
            document.getElementById('form-api-endpoint').value = '';
            document.getElementById('form-api-badge').value = '';
            document.getElementById('form-api-color').value = 'emerald';
            document.getElementById('form-api-models').value = '';
            document.getElementById('form-api-key').value = '';
            document.getElementById('form-api-doc').value = '';
            document.getElementById('form-api-desc').value = '';
            document.getElementById('modal-api-title').innerHTML = '<i class="fa-solid fa-key text-amber-400"></i><span>Thêm API Key Cá Nhân Mới</span>';
            const delBtn = document.getElementById('btn-delete-api');
            if (delBtn) delBtn.classList.add('hidden');
            openModal('modal-api-item');
        }

        function openEditApiModal(apiId) {
            const api = privateApisData.find(a => a.id === apiId);
            if (!api) return;

            document.getElementById('form-api-id').value = api.id;
            document.getElementById('form-api-provider').value = api.provider;
            document.getElementById('form-api-endpoint').value = api.endpoint || '';
            document.getElementById('form-api-badge').value = api.badge || '';
            document.getElementById('form-api-color').value = api.badgeColor || 'emerald';
            document.getElementById('form-api-models').value = api.models || api.limits || '';
            document.getElementById('form-api-key').value = api.apiKey || '';
            document.getElementById('form-api-doc').value = api.docUrl || '';
            document.getElementById('form-api-desc').value = api.desc || '';
            document.getElementById('modal-api-title').innerHTML = '<i class="fa-solid fa-pen-to-square text-blue-600"></i><span>Chỉnh Sửa API Key Cá Nhân</span>';
            const delBtn = document.getElementById('btn-delete-api');
            if (delBtn) delBtn.classList.remove('hidden');
            openModal('modal-api-item');
        }

        function saveApiItem(e) {
            e.preventDefault();
            const id = document.getElementById('form-api-id').value;
            const provider = document.getElementById('form-api-provider').value.trim();
            const endpoint = document.getElementById('form-api-endpoint').value.trim();
            const badge = document.getElementById('form-api-badge').value.trim() || 'Private Key';
            const badgeColor = document.getElementById('form-api-color').value;
            const models = document.getElementById('form-api-models').value.trim();
            const apiKey = document.getElementById('form-api-key').value.trim();
            const docUrl = document.getElementById('form-api-doc').value.trim();
            const desc = document.getElementById('form-api-desc').value.trim();

            if (id) {
                const api = privateApisData.find(a => a.id === id);
                if (api) {
                    api.provider = provider;
                    api.endpoint = endpoint;
                    api.badge = badge;
                    api.badgeColor = badgeColor;
                    api.models = models;
                    api.apiKey = apiKey;
                    api.docUrl = docUrl;
                    api.desc = desc;
                }
            } else {
                privateApisData.unshift({
                    id: 'custom-priv-api-' + Date.now(),
                    type: 'private',
                    provider: provider,
                    icon: 'fa-solid fa-key text-amber-400',
                    badge: badge,
                    badgeColor: badgeColor,
                    endpoint: endpoint,
                    models: models,
                    apiKey: apiKey,
                    docUrl: docUrl,
                    desc: desc
                });
            }

            savePrivateApisToStorage();
            closeModal('modal-api-item');
            renderApiVault();
            showToast('Lưu API Key cá nhân thành công!', 'success');
        }

        function deleteCurrentApi() {
            const id = document.getElementById('form-api-id').value;
            if (!id) return;
            if (!confirm('Bạn có chắc chắn muốn xóa API Key này khỏi danh sách?')) return;

            privateApisData = privateApisData.filter(a => a.id !== id);
            savePrivateApisToStorage();
            closeModal('modal-api-item');
            renderApiVault();
            showToast('Đã xóa API Key!', 'warning');
        }

