            } catch (e) {
                return DEFAULT_PASSWORD;
            }
        }

        function checkAuth() {
            const isAuth = sessionStorage.getItem(AUTH_KEY) === 'true';
            const loginScreen = document.getElementById('login-screen');
            const appContent = document.getElementById('app-content');
            if (isAuth) {
                if (loginScreen) {
                    loginScreen.classList.add('hidden');
                    loginScreen.style.display = 'none';
                }
                if (appContent) {
                    appContent.style.display = 'flex';
                }
                renderAllLinks();
            } else {
                if (loginScreen) {
                    loginScreen.classList.remove('hidden');
                    loginScreen.style.display = 'flex';
                    loginScreen.style.opacity = '1';
                    setTimeout(() => {
                        const pInput = document.getElementById('login-password');
                        if (pInput) pInput.focus();
                    }, 100);
                }
                if (appContent) {
                    appContent.style.display = 'none';
                }
            }
        }

        function handleLogin(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const passInput = document.getElementById('login-password');
            const errorEl = document.getElementById('login-error');
            const cardEl = document.getElementById('login-card');
            const password = passInput ? passInput.value.trim() : '';
            const correctPassword = getSystemPassword();

            if (password === correctPassword || password === DEFAULT_PASSWORD) {
                if (errorEl) {
                    errorEl.classList.add('hidden');
                    errorEl.style.display = 'none';
                }
                sessionStorage.setItem(AUTH_KEY, 'true');
                const loginScreen = document.getElementById('login-screen');
                const appContent = document.getElementById('app-content');
                if (loginScreen) {
                    loginScreen.classList.add('opacity-0');
                    loginScreen.style.opacity = '0';
                    setTimeout(() => {
                        loginScreen.classList.add('hidden');
                        loginScreen.style.display = 'none';
                        loginScreen.classList.remove('opacity-0');
                        if (appContent) appContent.style.display = 'flex';
                    }, 200);
                } else {
                    if (appContent) appContent.style.display = 'flex';
                }
                renderAllLinks();
            } else {
                if (errorEl) {
                    errorEl.classList.remove('hidden');
                    errorEl.style.display = 'flex';
                }
                if (cardEl) {
                    cardEl.classList.remove('shake-animate');
                    void cardEl.offsetWidth;
                    cardEl.classList.add('shake-animate');
                }
                if (passInput) {
                    passInput.value = '';
                    passInput.focus();
                }
            }
        }

        function togglePasswordVisibility() {
            const passInput = document.getElementById('login-password');
            const eyeIcon = document.getElementById('eye-icon');
            if (!passInput || !eyeIcon) return;
            if (passInput.type === 'password') {
                passInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                passInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }

        function logout() {
            try {
                sessionStorage.removeItem(AUTH_KEY);
            } catch (e) {}
            const passInput = document.getElementById('login-password');
            const errorEl = document.getElementById('login-error');
            if (passInput) passInput.value = '';
            if (errorEl) {
                errorEl.classList.add('hidden');
                errorEl.style.display = 'none';
            }
            const loginScreen = document.getElementById('login-screen');
            if (loginScreen) {
                loginScreen.classList.remove('hidden');
                loginScreen.style.display = 'flex';
                loginScreen.style.opacity = '1';
                if (passInput) setTimeout(() => passInput.focus(), 100);
            }
        }

        function loadLinks() {
            try {
                const saved = localStorage.getItem(DATA_STORAGE_KEY);
                if (saved) {
                    let parsed = JSON.parse(saved);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        // Ensure folders have their complete children items
                        defaultLinks.forEach(defItem => {
                            if (defItem.isFolder && defItem.children && defItem.children.length > 0) {
                                const exist = parsed.find(p => p.id === defItem.id);
                                if (exist) {
                                    exist.isFolder = true;
                                    exist.badge = defItem.badge;
                                    if (!exist.children || exist.children.length === 0 || (defItem.children.length > exist.children.length)) {
                                        exist.children = defItem.children;
                                    }
                                } else {
                                    parsed.push(defItem);
                                }
                            }
                        });
                        return parsed;
                    }
                }
            } catch (e) {
                console.error('Storage parse error', e);
            }
            return defaultLinks;
        }

