        function saveEditAccount() {
            let idVal = document.getElementById('edit-id').value;
            let isNew = !idVal;
            let acc;
            
            if(isNew) {
                acc = {
                    id: Date.now(),
                    customerIcon: 'fa-user',
                    member: 'Chưa có',
                    status: 'hoatdong'
                };
            } else {
                acc = accountsData.find(a => a.id === parseInt(idVal));
                if(!acc) return;
            }
            
            acc.type = document.getElementById('edit-type').value.toUpperCase();
            acc.name = document.getElementById('edit-name').value;
            acc.email = document.getElementById('edit-email').value;
            acc.pass = document.getElementById('edit-pass').value;
            acc.twoFA = document.getElementById('edit-twofa').value;
            acc.customer = document.getElementById('edit-customer').value;
            acc.bh = document.getElementById('edit-bh').value;
            acc.purchase = document.getElementById('edit-purchase').value;
            acc.expire = document.getElementById('edit-expire').value;
            acc.originalPrice = document.getElementById('edit-original-price').value;
            acc.sellPrice = document.getElementById('edit-sell-price').value;

            if (acc.expire) {
                const today = new Date();
                const exp = new Date(acc.expire);
                const diffTime = exp - today;
                acc.remainDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                if (acc.remainDays < 0) acc.remainDays = 0;
            } else {
                acc.remainDays = 0;
            }

            if(isNew) {
                accountsData.unshift(acc);
            }
            
            renderAccounts();
            closeEditAccount();
        }
