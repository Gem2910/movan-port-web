        function openFolder(item) {
            currentFolderItem = item;
            isApiVaultOpen = false;
            const dashboardOverview = document.getElementById('dashboard-overview');
            const individualView = document.getElementById('individual-section-view');
            const apiView = document.getElementById('api-list-view');
            const accountManagerView = document.getElementById('account-manager-view');
            if (accountManagerView) accountManagerView.classList.add('hidden');
            const folderView = document.getElementById('folder-view');

            if (dashboardOverview) dashboardOverview.classList.add('hidden');
            if (individualView) individualView.classList.add('hidden');
            if (apiView) apiView.classList.add('hidden');
            if (folderView) folderView.classList.remove('hidden');

            const secMeta = SECTIONS_METADATA.find(s => s.id === Number(item.section));
            const secTitle = secMeta ? secMeta.name : 'Danh mục';
            const breadcrumbSec = document.getElementById('folder-breadcrumb-section');
            if (breadcrumbSec) breadcrumbSec.textContent = secTitle;

            const nameEl = document.getElementById('folder-breadcrumb-name');
            if (nameEl) nameEl.textContent = item.name;

            const iconEl = document.getElementById('folder-breadcrumb-icon');
            if (iconEl) iconEl.className = (item.icon || 'fa-solid fa-folder text-amber-400') + ' mr-1';

            // Build chips if Trợ lý AI
            const chipContainer = document.getElementById('folder-category-chips');
            if (chipContainer) {
                if (item.name === 'Trợ lý AI') {
                    chipContainer.classList.remove('hidden');
                    chipContainer.innerHTML = `
                        <button onclick="setFolderSubFilter('all')" class="filter-chip ${folderSubFilter === 'all' ? 'active' : ''} px-2.5 py-0.5 text-[11px] whitespace-nowrap">Tất cả (${(item.children || []).length})</button>
                        <button onclick="setFolderSubFilter('Marketing')" class="filter-chip ${folderSubFilter === 'Marketing' ? 'active' : ''} px-2.5 py-0.5 text-[11px] whitespace-nowrap">Marketing & Sales</button>
                        <button onclick="setFolderSubFilter('Content')" class="filter-chip ${folderSubFilter === 'Content' ? 'active' : ''} px-2.5 py-0.5 text-[11px] whitespace-nowrap">Content & Viết lách</button>
                        <button onclick="setFolderSubFilter('Đồ Họa')" class="filter-chip ${folderSubFilter === 'Đồ Họa' ? 'active' : ''} px-2.5 py-0.5 text-[11px] whitespace-nowrap">Đồ Họa & Video</button>
                        <button onclick="setFolderSubFilter('Kỹ Thuật')" class="filter-chip ${folderSubFilter === 'Kỹ Thuật' ? 'active' : ''} px-2.5 py-0.5 text-[11px] whitespace-nowrap">Kỹ Thuật & Code</button>
                        <button onclick="setFolderSubFilter('Sức Khỏe')" class="filter-chip ${folderSubFilter === 'Sức Khỏe' ? 'active' : ''} px-2.5 py-0.5 text-[11px] whitespace-nowrap">Y Tế & Sức Khỏe</button>
                    `;
                } else {
                    chipContainer.classList.add('hidden');
                }
            }

            let children = item.children || [];

            if (folderSubFilter !== 'all') {
                children = children.filter(c => (c.badge || '').toLowerCase().includes(folderSubFilter.toLowerCase()));
            }

            if (searchQuery) {
                children = children.filter(c => c.name.toLowerCase().includes(searchQuery) || (c.desc && c.desc.toLowerCase().includes(searchQuery)));
            }

            const countEl = document.getElementById('folder-items-count');
            if (countEl) countEl.textContent = `${children.length} / ${(item.children || []).length} mục`;

            const cardsContainer = document.getElementById('folder-cards');
            if (cardsContainer) {
                cardsContainer.innerHTML = '';
                cardsContainer.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3';
                children.forEach(child => {
                    cardsContainer.insertAdjacentHTML('beforeend', createChildCardHTML(child, item.id));
                });
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function setFolderSubFilter(sub) {
            folderSubFilter = sub;
            if (currentFolderItem) openFolder(currentFolderItem);
        }

        
                
