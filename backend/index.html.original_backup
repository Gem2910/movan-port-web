<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movan Backend</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            purple: '#7C3AED',
                            purpleLight: '#8B5CF6',
                            purpleGlow: 'rgba(124, 58, 237, 0.4)',
                        },
                        sasste: {
                            base: '#0D1121',
                            sidebar: '#0F1326',
                            card: '#151B33',
                            cardHover: '#1B2342',
                            input: '#0B0E1B',
                            border: '#20294C',
                            borderHover: '#7C3AED'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/jsoneditor/9.10.3/jsoneditor.min.css" rel="stylesheet" type="text/css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsoneditor/9.10.3/jsoneditor.min.js"></script>
    <style>
        :root {
            --bg-base: #0D1121;
            --bg-sidebar: #0F1326;
            --bg-card: #151B33;
            --bg-card-hover: #1B2342;
            --bg-input: #0B0E1B;
            --border-color: #20294C;
            --border-hover: #8B5CF6;
            --accent: #7C3AED;
            --accent-glow: rgba(124, 58, 237, 0.35);
            --text-primary: #FFFFFF;
            --text-secondary: #94A3B8;
            --text-muted: #64748B;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .hidden {
            display: none !important;
        }

        /* Modern Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #0D1121;
        }
        ::-webkit-scrollbar-thumb {
            background: #20294C;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #7C3AED;
        }

        /* Card Styles */
        .sasste-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 1rem;
            transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .sasste-card:hover {
            border-color: rgba(139, 92, 246, 0.6);
            background-color: var(--bg-card-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.5);
        }
        .sasste-card.active-highlight {
            border: 2px solid #8B5CF6 !important;
            box-shadow: 0 0 20px rgba(139, 92, 246, 0.3) !important;
            background-color: #1A213F !important;
        }

        /* Navigation Buttons */
        .nav-btn {
            border-radius: 0.75rem;
            transition: all 0.18s ease;
            color: #94A3B8;
            padding: 0.6rem 0.85rem;
        }
        .nav-btn:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: #FFFFFF;
        }
        .nav-btn.active {
            background-color: #7C3AED !important;
            color: #FFFFFF !important;
            font-weight: 600;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.4);
        }
        .nav-btn.active i {
            color: #FFFFFF !important;
        }

        /* Submenu Button */
        .submenu-btn {
            border-radius: 0.5rem;
            transition: all 0.15s ease;
            color: #94A3B8;
        }
        .submenu-btn:hover {
            background-color: rgba(124, 58, 237, 0.15);
            color: #A78BFA;
        }

        /* Table & Row Hover */
        .table-row-hover {
            transition: background-color 0.15s ease;
            border-bottom: 1px solid #1A2242;
        }
        .table-row-hover:hover {
            background-color: #1B2342;
        }

        /* Status Pills (Matching Reference Image) */
        .status-pill-active {
            background-color: rgba(30, 58, 138, 0.4);
            color: #60A5FA;
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 9999px;
            font-size: 11px;
            padding: 0.2rem 0.65rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-weight: 500;
        }
        .status-pill-active::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 9999px;
            background-color: #3B82F6;
        }

        .status-pill-emerald {
            background-color: rgba(6, 78, 59, 0.4);
            color: #34D399;
            border: 1px solid rgba(16, 185, 129, 0.4);
            border-radius: 9999px;
            font-size: 11px;
            padding: 0.2rem 0.65rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-weight: 500;
        }
        .status-pill-emerald::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 9999px;
            background-color: #10B981;
        }

        /* Form Inputs */
        .cms-input, .sasste-input {
            background-color: var(--bg-input) !important;
            border: 1px solid var(--border-color) !important;
            color: #FFFFFF !important;
            border-radius: 0.75rem !important;
            transition: all 0.2s ease;
        }
        .cms-input:focus, .sasste-input:focus {
            border-color: #7C3AED !important;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.25) !important;
            outline: none !important;
        }

        /* Buttons */
        .btn-purple {
            background: linear-gradient(135deg, #7C3AED, #6D28D9);
            color: #FFFFFF;
            border-radius: 0.75rem;
            font-weight: 600;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
        }
        .btn-purple:hover {
            background: linear-gradient(135deg, #8B5CF6, #7C3AED);
            box-shadow: 0 6px 20px rgba(124, 58, 237, 0.5);
            transform: translateY(-1px);
        }

        .btn-dark {
            background-color: #151B33;
            border: 1px solid var(--border-color);
            color: #E2E8F0;
            border-radius: 0.75rem;
            font-weight: 500;
            transition: all 0.18s ease;
        }
        .btn-dark:hover {
            border-color: #7C3AED;
            background-color: #1B2342;
            color: #FFFFFF;
        }

        /* Modern Filter Chips */
        .filter-chip {
            background-color: #151B33;
            border: 1px solid var(--border-color);
            color: #94A3B8;
            border-radius: 9999px;
            padding: 0.35rem 0.9rem;
            font-size: 12px;
            font-weight: 500;
            transition: all 0.18s ease;
        }
        .filter-chip:hover {
            border-color: #7C3AED;
            color: #FFFFFF;
        }
        .filter-chip.active {
            background-color: #7C3AED;
            border-color: #7C3AED;
            color: #FFFFFF;
            box-shadow: 0 2px 10px rgba(124, 58, 237, 0.35);
        }

        /* Checkbox styling */
        input[type="checkbox"] {
            accent-color: #7C3AED;
            cursor: pointer;
        }

        .modal-overlay {
            background-color: rgba(7, 9, 18, 0.85);
            backdrop-filter: blur(8px);
        }

        /* Scoped Frontend (FE) Preview Styles */
        .fe-preview {
            font-family: 'Inter', sans-serif;
            line-height: 1.5;
            width: 100%;
        }
        .fe-preview h1, .fe-preview h2, .fe-preview h3, .fe-preview h4 {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 800;
            letter-spacing: -0.02em;
        }
        .fe-preview .outline-text {
            -webkit-text-stroke: 1.5px #000000;
            color: transparent;
            font-weight: 800;
        }
        .fe-preview .social-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border: 2px solid #000000;
            border-radius: 4px;
            color: #000000;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.2s ease;
        }
        .fe-preview .social-btn:hover {
            background: #000000;
            color: #ffffff;
        }
        .fe-preview .btn-black {
            background: #000000;
            color: #ffffff;
            border: none;
            padding: 10px 24px;
            font-size: 0.9rem;
            font-weight: 700;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .fe-preview .btn-black:hover {
            background: #333333;
        }
        .fe-preview .testimonial-card {
            padding: 24px 18px;
            text-align: center;
            border: 1px solid #eaeaea;
            border-radius: 12px;
            background: #fafafa;
            transition: all 0.3s ease;
        }
        .fe-preview .testimonial-card.dark {
            background: #000000;
            color: #ffffff;
            border-color: #000000;
        }
        .fe-preview .t-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            margin: 0 auto 12px;
            background: #eaeaea;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.1rem;
            color: #555555;
        }
        .fe-preview .testimonial-card.dark .t-avatar {
            background: #222222;
            color: #ffffff;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="min-h-screen flex flex-col md:flex-row antialiased overflow-x-hidden bg-grid">

    <!-- ========================================== -->
    <!-- 1. LOGIN SCREEN OVERLAY (Pass: 123)        -->
    <!-- ========================================== -->
    <div id="login-screen" class="fixed inset-0 z-50 flex items-center justify-center p-4 transition-opacity duration-300" style="background: radial-gradient(circle at center, rgba(30, 41, 59, 0.7) 0%, rgba(11, 15, 25, 0.95) 100%); backdrop-filter: blur(12px); display: flex;">
        <div id="login-card" class="w-full max-w-sm rounded-3xl p-8 relative shadow-2xl transition-all" style="background: var(--bg-card); border: 1px solid var(--border-color); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 40px -10px rgba(59, 130, 246, 0.15);">
            <div class="text-center mb-7">
                <div class="w-16 h-16 mx-auto rounded-2xl flex items-center justify-center mb-4 text-blue-400 text-2xl shadow-inner relative group" style="background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.3);">
                    <i class="fa-solid fa-shield-halved group-hover:scale-110 transition-transform"></i>
                    <div class="absolute -inset-1 rounded-2xl bg-blue-500/20 blur-md -z-10 opacity-70"></div>
                </div>
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-widest mb-2" style="background: rgba(59, 130, 246, 0.12); border: 1px solid rgba(59, 130, 246, 0.3); color: #60a5fa;">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                    <span>SECURE ACCESS</span>
                </div>
                <h2 class="text-xl font-bold tracking-tight" style="color: var(--text-primary);">Movan Cloud Portal</h2>
                <p class="text-xs mt-1" style="color: var(--text-muted);">Bảng điều khiển quản trị tập trung & kho dữ liệu</p>
            </div>

            <form onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-[11px] font-mono font-semibold uppercase tracking-wider mb-2" style="color: var(--text-secondary);">MẬT KHẨU TRUY CẬP</label>
                    <div class="relative">
                        <input id="login-password" type="password" placeholder="Nhập mật khẩu (Mặc định: 123)..." 
                            class="cms-input w-full px-4 py-3 text-sm font-mono transition pr-11" 
                            autocomplete="current-password" autofocus required>
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-blue-400 transition">
                            <i id="eye-icon" class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div id="login-error" class="hidden text-xs text-rose-300 rounded-xl p-3 flex items-center gap-2.5 font-mono" style="background: rgba(225, 29, 72, 0.15); border: 1px solid rgba(225, 29, 72, 0.3);">
                    <i class="fa-solid fa-circle-exclamation shrink-0 text-rose-400"></i>
                    <span>Mật khẩu không chính xác! Vui lòng thử lại.</span>
                </div>

                <button type="submit" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs tracking-wider uppercase transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-blue-600/30 hover:shadow-blue-600/50 hover:-translate-y-0.5 active:translate-y-0">
                    <i class="fa-solid fa-right-to-bracket text-xs"></i>
                    <span>Xác Thực & Đăng Nhập</span>
                </button>
            </form>

            <div class="text-center mt-6 pt-4 flex items-center justify-between text-[10px] font-mono" style="border-top: 1px solid var(--border-color); color: var(--text-muted);">
                <span>MOVAN ENTERPRISE</span>
                <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>ONLINE</span>
            </div>
        </div>
    </div>

    <!-- ========================================== -->
    <!-- 2. ENTERPRISE SIDEBAR NAVIGATION           -->
    <!-- ========================================== -->
    <div id="app-content" class="w-full min-h-screen flex-col md:flex-row flex-1" style="display: none;">
    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/70 z-30 hidden md:hidden"></div>

    <aside id="sidebar" class="fixed md:sticky top-0 left-0 h-screen w-64 flex flex-col z-40 transform -translate-x-full md:translate-x-0 transition-all duration-200 shrink-0 select-none" style="background-color: var(--bg-sidebar); border-right: 1px solid var(--border-color);">
        <!-- Logo & Header -->
        <div class="h-16 px-5 flex items-center justify-between shrink-0" style="border-bottom: 1px solid var(--border-color);">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white font-bold text-sm shadow-lg relative group" style="background: linear-gradient(135deg, #7C3AED, #6366F1); box-shadow: 0 4px 16px rgba(124, 58, 237, 0.45);">
                    <i class="fa-solid fa-shapes text-sm"></i>
                    <div class="absolute -inset-0.5 rounded-xl bg-purple-500/30 blur-sm -z-10 opacity-70"></div>
                </div>
                <div class="logo-text-wrapper min-w-0">
                    <div class="flex items-center gap-1.5">
                        <h1 class="text-sm font-bold tracking-tight text-white font-sans">Movan</h1>
                        <span class="text-[9px] px-1.5 py-0.5 rounded-full font-mono font-semibold" style="background: rgba(124, 58, 237, 0.25); color: #C4B5FD; border: 1px solid rgba(139, 92, 246, 0.35);">PRO</span>
                    </div>
                    <p class="text-[10px] font-sans tracking-wide text-slate-400">Enterprise Console</p>
                </div>
            </div>
            <button onclick="toggleSidebar()" class="sidebar-close-btn p-1.5 rounded-lg hover:bg-slate-800/50 text-slate-400 hover:text-white transition md:hidden" title="Thu gọn menu">
                <i class="fa-solid fa-xmark text-sm"></i>
            </button>
        </div>

        <!-- Navigation Categories -->
        <div class="flex-1 overflow-y-auto p-3.5 space-y-1">
            <!-- Category: MENU CHÍNH -->
            <div class="px-3 pt-2 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 font-sans">
                Menu Hệ Thống
            </div>
            <!-- Dashboard Overview -->
            <button id="nav-all" onclick="setFilterCategory('all')" class="nav-btn active w-full flex items-center justify-between px-3.5 py-2.5 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-chart-pie text-xs w-4 text-center text-purple-400"></i>
                    <span class="tracking-wide">Tổng Quan</span>
                </div>
                <span id="badge-count-all" class="text-[10px] px-2 py-0.5 rounded-full font-mono font-semibold bg-white/20 text-white">0</span>
            </button>
            
            <!-- Category: QUẢN TRỊ CMS (PORTFOLIO) -->
            <div class="px-3 pt-4 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 font-sans">
                Quản Trị CMS (Portfolio)
            </div>
            <button onclick="openCmsEditor('header')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-heading text-sky-400 text-xs w-4 text-center"></i>
                    <span>Header / Menu</span>
                </div>
            </button>
            <button onclick="openCmsEditor('cv')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-image text-cyan-400 text-xs w-4 text-center"></i>
                    <span>Khu vực Hero</span>
                </div>
            </button>
            <button onclick="openCmsEditor('cv.education')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-address-card text-indigo-400 text-xs w-4 text-center"></i>
                    <span>Khu vực About (Về tôi)</span>
                </div>
            </button>
            <button onclick="openCmsEditor('portfolio')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-layer-group text-emerald-400 text-xs w-4 text-center"></i>
                    <span>Khu vực Projects (Dự án)</span>
                </div>
            </button>
            <button onclick="openCmsEditor('testimonials')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-comment-dots text-amber-400 text-xs w-4 text-center"></i>
                    <span>Khu vực Testimonial</span>
                </div>
            </button>
            <button onclick="openCmsEditor('cv.phone')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-envelope text-rose-400 text-xs w-4 text-center"></i>
                    <span>Khu vực Contact</span>
                </div>
            </button>
            <button onclick="openCmsEditor('footer')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-shoe-prints text-purple-400 text-xs w-4 text-center"></i>
                    <span>Footer Website</span>
                </div>
            </button>

            <!-- Category: QUẢN LÝ AI (3) -->
            <div class="px-3 pt-4 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 font-sans">
                Quản Lý AI
            </div>
            <button id="nav-sec3" onclick="setFilterCategory('3')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-brain text-purple-400 text-xs w-4 text-center"></i>
                    <span>3. Tất Cả Dịch Vụ AI</span>
                </div>
            </button>
            <button onclick="openFolderById('sec3-5')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-robot text-purple-300 text-xs w-4 text-center"></i>
                    <span>155+ Trợ Lý AI</span>
                </div>
                <span class="text-[9px] px-1.5 py-0.5 rounded font-mono text-purple-300 bg-purple-950/60 border border-purple-800/40 font-semibold">155+</span>
            </button>
            <button onclick="openApiVault()" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-key text-amber-400 text-xs w-4 text-center"></i>
                    <span>Kho API Keys Vault</span>
                </div>
                <span class="text-[9px] px-1.5 py-0.5 rounded font-mono font-semibold" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">VAULT</span>
            </button>
            <button onclick="openInquiriesModal()" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-inbox text-amber-400 text-xs w-4 text-center"></i>
                    <span>Khách Hàng Liên Hệ</span>
                </div>
                <span id="badge-inquiries-count" class="text-[9px] px-1.5 py-0.5 rounded font-mono font-semibold" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">LEADS</span>
            </button>
            <a href="https://aiten.movan.id.vn" target="_blank" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-route text-sky-400 text-xs w-4 text-center"></i>
                    <span>9Router AI Gateway</span>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square text-[9px] opacity-60"></i>
            </a>

            <!-- Category: QUẢN LÝ KINH DOANH (4) -->
            <div class="px-3 pt-4 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 font-sans">
                Quản Lý Kinh Doanh
            </div>
            <button id="nav-sec4" onclick="setFilterCategory('4')" class="nav-btn w-full flex items-center justify-between px-3.5 py-2 text-xs font-medium">
                <div class="flex items-center gap-3">
