        async function fetchServerStats() {
            try {
                const res = await fetch('/monitor_data.json?t=' + new Date().getTime());
                if(!res.ok) return;
                const data = await res.json();
                
                if(data.success) {
                    // CPU
                    const cpuLoad = data.cpu.load ? data.cpu.load.toFixed(1) : 0;
                    document.getElementById('sm-cpu-val').textContent = cpuLoad + '%';
                    document.getElementById('sm-cpu-bar').style.width = cpuLoad + '%';
                    document.getElementById('sm-cpu-bar').className = `h-1.5 rounded-full transition-all duration-500 ${cpuLoad > 80 ? 'bg-rose-500' : 'bg-cyan-400'}`;
                    document.getElementById('sm-cpu-val').className = `text-3xl font-bold mb-1 ${cpuLoad > 80 ? 'text-rose-500' : 'text-cyan-400'}`;
                    
                    // RAM
                    if (data.mem && data.mem.total) {
                        const ramTotal = (data.mem.total / (1024**3)).toFixed(1);
                        const ramUsed = (data.mem.used / (1024**3)).toFixed(1);
                        const ramPerc = ((data.mem.used / data.mem.total) * 100).toFixed(1);
                        
                        document.getElementById('sm-ram-val').textContent = ramPerc + '%';
                        document.getElementById('sm-ram-bar').style.width = ramPerc + '%';
                        document.getElementById('sm-ram-bar').className = `h-1.5 rounded-full transition-all duration-500 ${ramPerc > 80 ? 'bg-rose-500' : 'bg-emerald-400'}`;
                        document.getElementById('sm-ram-val').className = `text-3xl font-bold mb-1 ${ramPerc > 80 ? 'text-rose-500' : 'text-emerald-400'}`;
                        document.getElementById('sm-ram-detail').textContent = `${ramUsed} / ${ramTotal} GB`;
                    }
                    
                    // SWAP
                    if (data.mem && data.mem.swaptotal !== undefined) {
                        const swTotal = (data.mem.swaptotal / (1024**3)).toFixed(1);
                        const swUsed = (data.mem.swapused / (1024**3)).toFixed(1);
                        const swPerc = data.mem.swaptotal > 0 ? ((data.mem.swapused / data.mem.swaptotal) * 100).toFixed(1) : 0;
                        
                        document.getElementById('sm-swap-val').textContent = swPerc + '%';
                        document.getElementById('sm-swap-bar').style.width = swPerc + '%';
                        document.getElementById('sm-swap-bar').className = `h-1.5 rounded-full transition-all duration-500 ${swPerc > 80 ? 'bg-rose-500' : 'bg-purple-400'}`;
                        document.getElementById('sm-swap-val').className = `text-3xl font-bold mb-1 ${swPerc > 80 ? 'text-rose-500' : 'text-purple-400'}`;
                        document.getElementById('sm-swap-detail').textContent = `${swUsed} / ${swTotal} GB`;
                    }
                    
                    // DISK
                    if (data.disk && data.disk.total !== undefined) {
                        const dskTotal = (data.disk.total / (1024**3)).toFixed(1);
                        const dskUsed = (data.disk.used / (1024**3)).toFixed(1);
                        const dskPerc = data.disk.perc || 0;
                        
                        document.getElementById('sm-disk-val').textContent = dskPerc + '%';
                        document.getElementById('sm-disk-bar').style.width = dskPerc + '%';
                        document.getElementById('sm-disk-bar').className = `h-1.5 rounded-full transition-all duration-500 ${dskPerc > 80 ? 'bg-rose-500' : 'bg-orange-400'}`;
                        document.getElementById('sm-disk-val').className = `text-3xl font-bold mb-1 ${dskPerc > 80 ? 'text-rose-500' : 'text-orange-500'}`;
                        document.getElementById('sm-disk-detail').textContent = `${dskUsed} / ${dskTotal} GB`;
                    }
                    
                    // NETWORK
                    if (data.network) {
                        const rx = (data.network.rx_sec / 1024).toFixed(1); // KB/s
                        const tx = (data.network.tx_sec / 1024).toFixed(1); // KB/s
                        
                        document.getElementById('sm-net-rx').textContent = rx > 1024 ? (rx/1024).toFixed(2) + ' MB/s' : rx + ' KB/s';
                        document.getElementById('sm-net-tx').textContent = tx > 1024 ? (tx/1024).toFixed(2) + ' MB/s' : tx + ' KB/s';
                    }
                    
                    // DOCKER
                    if (data.docker && Array.isArray(data.docker)) {
                        const tbody = document.getElementById('sm-docker-list');
                        document.getElementById('sm-docker-time').textContent = new Date().toLocaleTimeString();
                        
                        if (data.docker.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="4" class="px-4 py-4 text-center text-slate-500">Không có container nào đang chạy</td></tr>';
                        } else {
                            // Sort by RAM % if possible (descending)
                            const sorted = data.docker.sort((a,b) => parseFloat(b.memPerc) - parseFloat(a.memPerc));
                            
                            tbody.innerHTML = sorted.map(d => `
                                <tr class="hover:bg-gray-50 transition-colors">
                                    <td class="px-4 py-2.5 flex items-center gap-2"><i class="fa-solid fa-box text-gray-400"></i> <span class="text-gray-700 font-semibold">${d.name}</span></td>
                                    <td class="px-4 py-2.5">
                                        <span class="${parseFloat(d.cpu) > 50 ? 'text-rose-500 font-bold' : 'text-gray-600'}">${d.cpu}</span>
                                    </td>
                                    <td class="px-4 py-2.5">
                                        <span class="${parseFloat(d.memPerc) > 50 ? 'text-rose-500 font-bold' : 'text-gray-600'}">${d.memPerc}</span>
                                    </td>
                                    <td class="px-4 py-2.5 text-gray-500">${d.memUsage}</td>
                                </tr>
                            `).join('');
                        }
                    }
                }
            } catch(e) {
                console.error('Fetch Monitor Error:', e);
            }
        }

