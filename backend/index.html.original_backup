                        <textarea data-path="${field.path}" oninput="updateCmsLivePreview()" class="cms-input sasste-input w-full px-4 py-2.5 text-xs text-white leading-relaxed" rows="4">${val}</textarea>
                    </div>`;
                } else if (field.type === 'image') {
                    const val = getValByPath(cmsCurrentData, field.path) || '';
                    const safePath = field.path.replace(/\./g, '_');
