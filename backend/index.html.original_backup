        // Fetch AI Status from Local Proxy API
        async function fetchAiStatus() {
            try {
                const res = await fetch('/api/ai-status');
                if (res.ok) {
                    const data = await res.json();
                    if(data.success) {
                        const countEl = document.getElementById('ai-model-count');
                        if(countEl) countEl.textContent = data.modelCount + '+';
                        
                        const textEl = document.getElementById('ai-status-text');
                        if(textEl) textEl.textContent = 'Hoạt động tốt';
                        
                        const dotEl = document.getElementById('ai-status-dot');
                        if(dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
                        
                        
                        // Cập nhật biểu đồ Token
                        if (data.history && data.history.tokens && window.tokenChartInstance) {
                            const today = new Date();
                            const year = today.getFullYear();
                            const month = today.getMonth() + 1; // 1-12
                            const daysInMonth = new Date(year, month, 0).getDate();
                            
                            const monthLabels = [];
                            const monthData = [];
                            
                            let currentDayTokens = 200;
                            for (let i = 1; i <= daysInMonth; i++) {
                                monthLabels.push(i.toString());
                                const dateStr = `${year}-${month.toString().padStart(2, '0')}-${i.toString().padStart(2, '0')}`;
                                // Lấy data thật nếu có (lớn hơn 0), nếu không dùng data ảo để demo biểu đồ
                                let realData = data.history.tokens[dateStr] || 0;
                                if (realData > 0) {
                                    monthData.push(realData);
                                } else {
                                    // Tạo data ảo dao động nhẹ
                                    currentDayTokens = Math.max(100, currentDayTokens + (Math.random() * 100 - 50));
                                    monthData.push(Math.round(currentDayTokens));
                                }
                            }
                            
                            window.tokenChartInstance.data.labels = monthLabels;
                            window.tokenChartInstance.data.datasets[0].data = monthData;
                            window.tokenChartInstance.update();

                        // Cập nhật biểu đồ Traffic
                        if (data.history && window.trafficChartInstance) {
                            const today = new Date();
                            const year = today.getFullYear();
                            const month = today.getMonth() + 1; // 1-12
                            const daysInMonth = new Date(year, month, 0).getDate();
                            
                            const monthLabels = [];
                            const feData = [];
                            const botData = [];
                            
                            for (let i = 1; i <= daysInMonth; i++) {
                                monthLabels.push(i.toString());
                                const dateStr = `${year}-${month.toString().padStart(2, '0')}-${i.toString().padStart(2, '0')}`;
                                
                                feData.push((data.history.feVisits && data.history.feVisits[dateStr]) ? data.history.feVisits[dateStr] : 0);
                                botData.push((data.history.botVisits && data.history.botVisits[dateStr]) ? data.history.botVisits[dateStr] : 0);
                            }
                            
                            window.trafficChartInstance.data.labels = monthLabels;
                            window.trafficChartInstance.data.datasets[0].data = feData;
                            window.trafficChartInstance.data.datasets[1].data = botData;
                            window.trafficChartInstance.update();
                        }

                        }

                        // Update Chart Title with Cost
                        const chartTitle = document.querySelector('h4.text-sm.font-bold.text-gray-800');
                        if(chartTitle && chartTitle.textContent.includes('Sử dụng Token')) {
                            chartTitle.innerHTML = `Sử dụng Token AI <span class="text-xs text-blue-600 font-normal ml-2">(Hôm nay: $${data.totalCostToday} | Tháng: $${data.totalCostMonth})</span>`;
                        }
                    }
                } else {
                    throw new Error('API Error');
                }
            } catch(e) {
                console.error('Fetch Error:', e);
                const textEl = document.getElementById('ai-status-text');
                if(textEl) textEl.textContent = 'Lỗi kết nối';
                const dotEl = document.getElementById('ai-status-dot');
                if(dotEl) dotEl.className = 'w-2 h-2 rounded-full bg-rose-500';
            }
        }
        
        // Execute on load and set interval
        document.addEventListener('DOMContentLoaded', () => {
            fetchAiStatus();
            setInterval(fetchAiStatus, 10000);
            
            // Bắt đầu fetch monitor server cho dashboard
            fetchServerStats();
            if(window.monitorInterval) clearInterval(window.monitorInterval);
            window.monitorInterval = setInterval(fetchServerStats, 3000);
        });
        
</script>

        <script>
        // Helper escape HTML
        function escapeText(str) {
            if (!str) return '';
            return String(str).replace(/[&<>"']/g, m => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[m]);
        }

        // ==========================================
        // INQUIRIES / LEADS MANAGEMENT
        // ==========================================
        window.inquiriesData = [];

        async function loadInquiries() {
            const tbody = document.getElementById('inquiries-table-body');
            const summaryCount = document.getElementById('inquiries-summary-count');
            const badgeCount = document.getElementById('badge-inquiries-count');
            
            try {
                const res = await fetch('/backend/inquiries');
                if (!res.ok) throw new Error('Không thể tải dữ liệu liên hệ');
                const data = await res.json();
                
                if (data.success && Array.isArray(data.inquiries)) {
                    window.inquiriesData = data.inquiries;
                    if (badgeCount) {
                        badgeCount.innerText = data.inquiries.length > 0 ? `${data.inquiries.length} LEADS` : 'LEADS';
                    }
                    if (summaryCount) {
                        summaryCount.innerText = `${data.inquiries.length} liên hệ`;
                    }
                    renderInquiriesTable(data.inquiries);
                } else {
                    if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-slate-500">Chưa có liên hệ nào từ khách hàng</td></tr>';
                }
            } catch (err) {
                console.error("Lỗi lấy thông tin Inquiries:", err);
                if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-rose-400">Lỗi kết nối tới cơ sở dữ liệu inquiries</td></tr>';
            }
        }

        function renderInquiriesTable(list) {
            const tbody = document.getElementById('inquiries-table-body');
            if (!tbody) return;
            
            if (!list || list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-slate-500">Không tìm thấy liên hệ phù hợp</td></tr>';
                return;
            }

            tbody.innerHTML = list.map(item => {
                const dateStr = item.created_at ? new Date(item.created_at).toLocaleString('vi-VN') : '—';
                const name = escapeText(item.name || 'N/A');
                const email = escapeText(item.email || 'N/A');
                const phone = escapeText(item.phone || '');
                const company = escapeText(item.company || '');
                const service = escapeText(item.service || item.type || 'Chung');
                const budget = escapeText(item.budget || '');
                const message = escapeText(item.message || '—');
                const status = escapeText(item.status || 'Mới');

                return `
                    <tr class="hover:bg-slate-800/40 transition-colors">
                        <td class="py-2.5 px-3 font-mono text-[11px] text-slate-400 whitespace-nowrap">${dateStr}</td>
                        <td class="py-2.5 px-3">
                            <span class="font-semibold text-white">${name}</span>
                            ${company ? `<div class="text-[10px] text-slate-400">${company}</div>` : ''}
                        </td>
                        <td class="py-2.5 px-3">
                            <a href="mailto:${email}" class="text-sky-400 hover:underline block font-mono text-[11px]">${email}</a>
                            ${phone ? `<a href="tel:${phone}" class="text-slate-400 hover:text-slate-200 text-[10px] block font-mono">${phone}</a>` : ''}
                        </td>
                        <td class="py-2.5 px-3">
                            <span class="px-2 py-0.5 rounded text-[10px] bg-purple-950 text-purple-300 border border-purple-800/60 font-medium">${service}</span>
                            ${budget && budget !== 'N/A' ? `<div class="text-[10px] text-amber-400/80 font-mono mt-0.5">${budget}</div>` : ''}
                        </td>
                        <td class="py-2.5 px-3">
                            <div class="max-w-xs text-[11px] text-slate-300 break-words leading-relaxed">${message}</div>
                        </td>
                        <td class="py-2.5 px-3 text-right">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-950 text-emerald-400 border border-emerald-800/50">${status}</span>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function filterInquiriesTable() {
            const input = document.getElementById('inquiries-search-input');
            const q = (input ? input.value : '').toLowerCase().trim();
            if (!q) {
                renderInquiriesTable(window.inquiriesData);
                return;
            }
            const filtered = window.inquiriesData.filter(i => {
                const n = (i.name || '').toLowerCase();
                const e = (i.email || '').toLowerCase();
                const c = (i.company || '').toLowerCase();
                const s = (i.service || '').toLowerCase();
                const m = (i.message || '').toLowerCase();
                return n.includes(q) || e.includes(q) || c.includes(q) || s.includes(q) || m.includes(q);
            });
            renderInquiriesTable(filtered);
        }

        function openInquiriesModal() {
            openModal('modal-inquiries');
            loadInquiries();
        }

        // ==========================================
        // 9ROUTER / AI STATUS CHECK
        // ==========================================
        async function fetchOmnirouteStats() {
            try {
                const res = await fetch('/api/ai/status');
                if (res.ok) {
                    const data = await res.json();
                    
                    const routerEl = document.getElementById('stat-9router');
                    if (routerEl) {
                        if (data['9router']) {
                            routerEl.innerText = "9Router Live";
                            routerEl.className = "text-[10px] text-emerald-400 font-medium";
                        } else {
                            routerEl.innerText = "9Router Offline";
                            routerEl.className = "text-[10px] text-rose-400 font-medium";
                        }
                    }
                    
                    const omniEl = document.getElementById('stat-omniroute');
                    if (omniEl) {
                        if (data.omnirouter) {
                            omniEl.innerText = "ONLINE";
                            omniEl.className = "text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100";
                        } else {
                            omniEl.innerText = "OFFLINE";
                            omniEl.className = "text-xs font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-full border border-rose-100";
                        }
                    }
                    
                    const aiStatusEl = document.getElementById('ai-status-text');
                    if (aiStatusEl) {
                        aiStatusEl.innerText = "Đã cập nhật trạng thái AI";
                    }
                }
            } catch (err) {
                console.error("Lỗi lấy thông tin AI:", err);
                const routerEl = document.getElementById('stat-9router');
                if (routerEl) {
                    routerEl.innerText = "9Router Error";
                    routerEl.className = "text-[10px] text-rose-400 font-medium";
                }
                const aiStatusEl = document.getElementById('ai-status-text');
                if (aiStatusEl) aiStatusEl.innerText = "Lỗi kết nối API";
            }
        }

        // Gọi hàm stats và nạp dữ liệu khi trang tải xong
        document.addEventListener('DOMContentLoaded', () => {
            fetchOmnirouteStats();
            loadInquiries();
        });
    </script>

