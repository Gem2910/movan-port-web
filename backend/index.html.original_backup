                    if (hubGrid) hubGrid.parentElement.classList.add('hidden');
                    if (searchResultsDiv) searchResultsDiv.classList.remove('hidden');

                    let matchedItems = [];
                    linksData.forEach(item => {
                        if (item.isFolder && item.children) {
                            item.children.forEach(c => {
                                if (c.name.toLowerCase().includes(searchQuery) || (c.desc && c.desc.toLowerCase().includes(searchQuery))) {
                                    matchedItems.push({ ...c, parentId: item.id });
                                }
                            });
                        }
                        if (item.name.toLowerCase().includes(searchQuery) || (item.desc && item.desc.toLowerCase().includes(searchQuery))) {
                            matchedItems.push(item);
                        }
                    });

                    if (searchCount) searchCount.textContent = `${matchedItems.length} kết quả`;
                    if (searchGrid) {
                        searchGrid.innerHTML = '';
                        matchedItems.forEach(item => {
                            if (item.parentId) {
